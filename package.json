{
  "name": "ga-food-scores",
  "version": "1.0.0",
  "description": "Read-only REST API for Georgia restaurant inspection scores",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node node_modules/typescript-7/bin/tsc",
    "lint": "eslint .",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "sync": "tsx src/ingest/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
